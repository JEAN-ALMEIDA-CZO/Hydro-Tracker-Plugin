{
  "Author": "Jean Almeida",
  "Name": "Hydro Tracker",
  "Description": "Stay hydrated with the Hydro Tracker plugin for Stream Deck. Track your daily water intake and get reminders if you go too long without drinking water. Features beautiful liquid animations and OS notifications.",
  "Category": "Health & Fitness",
  "CategoryIcon": "assets/icons/brand.svg",
  "Icon": "assets/icons/brand.svg",
  "Version": "1.0.1",
  "UUID": "com.hydro.tracker.deck",
  "Type": "JavaScript",
  "CodePath": "plugin/app.js",
  "PrivateAPI": true,
  "SupportedInMultiActions": false,
  "Actions": [
    {
      "Name": "Hydro Tracker",
      "Icon": "assets/icons/actionIcon.svg",
      "UUID": "com.hydro.tracker.deck.action",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "States": [
        {
          "Name": "Default",
          "Image": "assets/icons/actionIcon.svg"
        }
      ],
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false
    }
  ],
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac",     "MinimumVersion": "10.11" }
  ],
  "Software": {
    "MinVersion": "2.1.0"
  }
}
